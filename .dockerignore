# Dépendances et builds locaux (reconstruits dans l'image)
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# VCS, CI, éditeurs
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Base et médias de développement (DATA_DIR=./data)
data

# Secrets / env locaux (« **/ » : à la racine comme dans n'importe quel dossier)
.env*
*.pem
**/*.pem
**/.npmrc
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*
# Bases SQLite hors de data/ (copies, bases de test)
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
# Outils locaux (worktrees entiers, notes, réglages locaux)
.local

# Artefacts locaux (captures, logs, nohup)
screenshots
*.log
nohup.out

# Outillage de test Playwright (hors runtime)
/*.mjs
!/eslint.config.mjs
!/postcss.config.mjs
scripts
# Scripts appelés par `npm run build` (vérifié par scripts/check-docker-context.mjs).
!scripts/copy-kit-native.mjs
# Restauration d'une sauvegarde, copiée dans l'image (docs/SAUVEGARDES.md).
!scripts/restore-backup.mjs
# Jeux de test (PSD de l'artiste…) : jamais utiles au build.
tests
test-results
playwright-report

# Docker / docs (docs/ contient le rapport d'audit de sécurité : jamais dans le contexte, ni donc dans le cache BuildKit)
Dockerfile
.dockerignore
compose*.y*ml
docker-compose*.y*ml
README.md
docs/ARCHITECTURE.md
docs
