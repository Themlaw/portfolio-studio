{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "tsc --noEmit && LOW_MEM_BUILD=1 MIMALLOC_PURGE_DELAY=0 MIMALLOC_ARENA_EAGER_COMMIT=0 MIMALLOC_ALLOW_LARGE_OS_PAGES=0 next build",
    "start": "next start",
    "lint": "eslint",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.mjs",
    "check:contrast:render": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast-render.mjs",
    "shots:themes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/theme-shots.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-references.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-sniff.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-ffmpeg-args.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-tags.mjs && node scripts/test-admin-guard.mjs && node scripts/check-standalone.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "shots:admin": "node scripts/admin-shots.mjs",
    "test:e2e": "node scripts/e2e-admin.mjs && node scripts/e2e-planche.mjs && node scripts/e2e-video.mjs && node scripts/e2e-tags.mjs",
    "shots:editors": "node scripts/editor-shots.mjs",
    "shots:planche": "node scripts/planche-shots.mjs",
    "shots:video": "node scripts/video-shots.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.3",
    "match-sorter": "8.3.0",
    "next": "^16.3.8",
    "next-intl": "^4.13.6",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "oauth2-mock-server": "^9.2.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
