# Résultats de scripts/audit-public.mjs relus un par un et acceptés (lot 103).
# Format : « classe chemin-ou-motif » ou « classe blob:<sha> » ; commentaire après « # ».
# Une nouvelle entrée doit être justifiée dans la demande de tirage.

# Polices libres (licence OFL) : binaires tiers, noms et e-mails des fondeurs dans les textes de licence.
media public/kit/**
media src/themes/fonts/*
infra public/kit/**
email public/kit/**

# Vignettes de thèmes et vidéo de démonstration : produites par les scripts du dépôt (theme-thumbs, seed de test).
media public/themes/*/thumb.webp
media seed/media/*
media public/favicon.ico

# Valeurs de TEST dans des jeux d'essai (adresses IP privées inventées, identifiants de réseaux sociaux fictifs).
infra scripts/test-auth.mjs
infra scripts/test-publish.mjs
infra scripts/test-containers.mjs

# Modèles de réécriture d'historique : valeurs d'EXEMPLE (example.org, adresses .invalid), pas de vraies données.
infra scripts/public-history/*
email scripts/public-history/*

# Texte officiel de la licence AGPL-3.0 : adresses du site de la FSF.
infra LICENSE

# Images du tutoriel admin : régénérées par scripts/tuto-shots.mjs sur un PSD SYNTHETIQUE (scripts/make-fixture-psd.mts)
# et un site de démonstration fictif ; leurs anciennes versions sont retirées de l'historique (forbidden.txt).
media public/admin/tuto/*

# --- AJOUTS secu-v100 (a relire par la coordinatrice) : valeurs de TEST synthetiques, relues une par une ---
# .npmrc : `ignore-scripts=true` (lot securite #48), aucun jeton ; detecte seulement par son nom.
forbidden .npmrc
# Tests d attaque : secrets, mots de passe et e-mails SYNTHETIQUES (example.test, SYNTH-..., 0123456789abcdef).
secret scripts/e2e-secuA.mjs
secret scripts/secuB-ffmpeg.mjs
secret scripts/secuC-journal.mjs
secret scripts/test-auth.mjs
email scripts/e2e-secuA.mjs
# Espaces de noms SVG / DOCTYPE du W3C dans des SVG de test ; adresse IP privee d EXEMPLE dans un test de spam.
infra scripts/secuB-svg.mjs
infra scripts/secuC-contact-spam.mjs
# Lien vers le site de l outil de chiffrement age (documentation).
infra docs/SAUVEGARDES.md
