# Aucun script d'installation de paquet (preinstall / install / postinstall) : un paquet compromis
# ne s'exécute pas au `npm ci` / `npm install`. Les rares paquets qui en ont besoin se reconstruisent
# explicitement : `npm rebuild better-sqlite3` (voir README, « Développement »). La CI et l'image passent
# déjà --ignore-scripts.
ignore-scripts=true
