# Portfolio — variables du conteneur. Copier en .env à côté de docker-compose.yml
# (Komodo : coller ces lignes dans l'onglet Environment de la stack).
# Seul BETTER_AUTH_SECRET est obligatoire ; tout le reste a une valeur par défaut.

# ---- Image -------------------------------------------------------------------
# Tag de ghcr.io/themlaw/portfolio : latest (main), sha-1a2b3c4, v0.8.0, da-pro…
# PORTFOLIO_TAG=latest

# ---- Site --------------------------------------------------------------------
# URL publique (canonical, hreflang, origine de confiance, retour OIDC).
# PUBLIC_BASE_URL=https://portfolio.example.org
# Changement de domaine : PUBLIC_BASE_URL = le NOUVEAU domaine, et REDIRECT_FROM = le ou les anciens
# (noms de domaine seuls, séparés par des virgules). Toute visite d'un ancien domaine est renvoyée vers
# la même page du nouveau. Vide ou absent : aucune redirection. Voir docs/DOMAINE.md.
# REDIRECT_FROM=portfolio.example.org

# Thème du seed initial (premier démarrage sur volume vide uniquement) ; ensuite
# le thème actif est en base (Admin → Thèmes). Défaut : galerie-lumineuse.
# PORTFOLIO_THEME=galerie-lumineuse

# ---- Administration (/admin) -------------------------------------------------
# Secret de session, OBLIGATOIRE (≥ 32 caractères). Le générer avec :
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Premier administrateur, créé au démarrage si aucun compte n'existe encore.
# Le mot de passe n'est jamais journalisé ; ces deux lignes peuvent être retirées
# une fois le compte créé (ou si la connexion passe uniquement par Authentik).
# ADMIN_EMAIL=moi@example.com
# ADMIN_PASSWORD=

# Connexion Authentik (les trois sont nécessaires, sinon désactivée).
# URL de redirection à déclarer dans Authentik :
#   ${PUBLIC_BASE_URL}/api/auth/callback/authentik
# AUTH_OIDC_ISSUER=https://auth.example.org/application/o/portfolio
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=

# Qui peut administrer via Authentik (au moins un des trois) :
#  - un groupe Authentik (RECOMMANDÉ, claim « groups », appartenance gérée dans Authentik)
# AUTH_ADMIN_GROUP=admins-portfolio
#  - des identifiants Authentik explicites (« sub »), séparés par des virgules (le plus strict)
# AUTH_ADMIN_SUBS=
#  - des e-mails, acceptés SEULEMENT si Authentik les déclare vérifiés. Mode le plus
#    faible : suppose une instance sans auto-inscription ni changement d'e-mail libre.
# ADMIN_EMAILS=moi@example.com

# true = connexion par mot de passe coupée. Pris en compte SEULEMENT si les trois
# variables AUTH_OIDC_* sont définies (sinon ignoré, pour ne jamais s'enfermer dehors).
# AUTH_PASSWORD_DISABLED=true

# Nombre de proxys de confiance devant le site (Pangolin/Newt) : l'IP client est
# l'entrée n°N de X-Forwarded-For en partant de la droite. À vérifier après
# déploiement dans Admin → Réglages → Diagnostic (l'IP retenue doit être la tienne).
# AUTH_TRUSTED_PROXY_HOPS=1

# ---- Images ------------------------------------------------------------------
# Taille maximale d'une image envoyée, en Mo. Défaut : 200.
# MAX_IMAGE_MB=200
# Plafond des PNG 16 bits, en mégapixels. Défaut : 100 (comme les autres images).
# MAX_MEGAPIXELS_16BIT=100
# Durée maximale du traitement d'une image, en secondes. Défaut : 120.
# JOB_MAX_DURATION_S=120

# ---- Envois ------------------------------------------------------------------
# Abandon d'un envoi qui ne reçoit plus rien, et durée maximale d'un envoi en
# une fois, en secondes. Défauts : 30 et 600.
# UPLOAD_IDLE_TIMEOUT_S=30
# UPLOAD_MAX_DURATION_S=600
# Quota de stockage des médias, en Go (originaux + variantes). Vide : sans limite.
# RECOMMANDÉ en production : un compte admin compromis ou un script qui boucle
# remplirait sinon /data (base, sauvegardes, journal en panne). Prévoir de la place
# pour les sauvegardes en plus (WITH_BACKUP) : par exemple 40 % du disque.
# MEDIA_MAX_TOTAL_GB=10
# Espace laissé libre sur le disque des données, en Mo : un envoi (ou un morceau)
# qui le consommerait est refusé, quota ou non. Défaut : 512 ; 0 : aucune garde.
# UPLOAD_MIN_FREE_MB=512

# ---- Vidéos ------------------------------------------------------------------
# Poids (Mo), durée (s) et plus grand côté (px) maximaux ; durée maximale d'une
# conversion (s). Défauts : 2048, 1800, 3840, 3600.
# MAX_VIDEO_MB=2048
# MAX_VIDEO_DURATION_S=1800
# MAX_VIDEO_DIMENSION=3840
# VIDEO_JOB_MAX_DURATION_S=3600
# Garder le fichier envoyé après conversion (défaut false : supprimé une fois les
# sorties validées, pour économiser le disque).
# KEEP_VIDEO_ORIGINALS=false
